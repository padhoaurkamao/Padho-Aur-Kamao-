<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Padho Aur Kamao - My Course</title>

<style>

/* ===============================
   GLOBAL
================================ */

*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f4f7fb;
  color:#111827;
}


/* ===============================
   HEADER
================================ */

header{
  background:
  linear-gradient(
    135deg,
    #2563eb,
    #7c3aed
  );

  color:white;

  padding:16px;
}


.header-container{
  max-width:1200px;

  margin:auto;

  display:flex;

  justify-content:space-between;

  align-items:center;

  gap:15px;
}


.logo h2{
  margin:0;

  font-size:24px;
}


.logo p{
  margin:5px 0 0;

  font-size:13px;

  opacity:.9;
}


.back-btn{
  background:white;

  color:#2563eb;

  border:none;

  padding:11px 16px;

  border-radius:10px;

  font-weight:bold;

  cursor:pointer;

  font-size:14px;
}


/* ===============================
   MAIN
================================ */

main{

  max-width:1200px;

  margin:auto;

  padding:25px 18px 50px;

}


/* ===============================
   COURSE HERO
================================ */

.course-hero{

  background:white;

  border-radius:20px;

  padding:25px;

  box-shadow:
  0 5px 20px #0001;

  margin-bottom:30px;

}


.course-hero h1{

  margin:0;

  font-size:28px;

}


.course-hero p{

  color:#6b7280;

  margin-bottom:0;

  line-height:1.6;

}


.package-badge{

  display:inline-block;

  margin-top:15px;

  padding:8px 14px;

  border-radius:30px;

  background:#eef2ff;

  color:#4338ca;

  font-weight:bold;

}


/* ===============================
   SECTION TITLE
================================ */

.section-title{

  margin-top:30px;

  margin-bottom:18px;

}


.section-title h2{

  margin:0;

  font-size:23px;

}


.section-title p{

  color:#6b7280;

  margin-top:7px;

}


/* ===============================
   BOOK GRID
================================ */

.book-grid{

  display:grid;

  grid-template-columns:
  repeat(
    auto-fit,
    minmax(220px,1fr)
  );

  gap:24px;

}


/* ===============================
   BOOK CARD
================================ */

.book-card{

  position:relative;

  height:320px;

  cursor:pointer;

  perspective:1000px;

}


.book-card:hover
.book-cover{

  transform:
  rotateY(-8deg)
  translateY(-8px);

}


.book-cover{

  width:100%;

  height:100%;

  position:relative;

  border-radius:
  8px
  18px
  18px
  8px;

  overflow:hidden;

  color:white;

  padding:25px 20px;

  display:flex;

  flex-direction:column;

  justify-content:space-between;

  box-shadow:

  inset 10px 0 15px #0002,

  0 15px 30px #0004;

  transition:.35s;

}


/* BOOK SPINE */

.book-cover::before{

  content:"";

  position:absolute;

  left:0;

  top:0;

  width:18px;

  height:100%;

  background:

  linear-gradient(
    90deg,
    #0005,
    transparent
  );

}


/* PAGE EFFECT */

.book-cover::after{

  content:"";

  position:absolute;

  right:0;

  top:10px;

  width:8px;

  height:calc(100% - 20px);

  background:

  repeating-linear-gradient(

    to bottom,

    #ffffff99,

    #ffffff99 2px,

    #d1d5db 3px,

    #d1d5db 4px

  );

  border-radius:
  0
  6px
  6px
  0;

}


/* ===============================
   BOOK COLORS
================================ */

.blue{

  background:
  linear-gradient(
    135deg,
    #1d4ed8,
    #2563eb,
    #60a5fa
  );

}


.purple{

  background:
  linear-gradient(
    135deg,
    #581c87,
    #7e22ce,
    #c084fc
  );

}


.green{

  background:
  linear-gradient(
    135deg,
    #065f46,
    #16a34a,
    #4ade80
  );

}


.orange{

  background:
  linear-gradient(
    135deg,
    #9a3412,
    #ea580c,
    #fb923c
  );

}


.red{

  background:
  linear-gradient(
    135deg,
    #991b1b,
    #dc2626,
    #f87171
  );

}


.dark{

  background:
  linear-gradient(
    135deg,
    #111827,
    #374151,
    #6b7280
  );

}


/* ===============================
   BOOK CONTENT
================================ */

.book-top{

  display:flex;

  justify-content:space-between;

  align-items:center;

}


.book-icon{

  width:55px;

  height:55px;

  border-radius:14px;

  background:#ffffff22;

  display:flex;

  align-items:center;

  justify-content:center;

  font-size:28px;

  backdrop-filter:
  blur(5px);

}


.book-tag{

  font-size:11px;

  padding:6px 10px;

  background:#ffffff22;

  border-radius:20px;

}


.book-middle{

  text-align:center;

}


.book-middle h3{

  font-size:25px;

  margin:0 0 12px;

}


.book-middle p{

  margin:0;

  font-size:13px;

  opacity:.9;

  line-height:1.5;

}


.book-bottom{

  text-align:center;

}


.open-book{

  background:white;

  color:#1e3a8a;

  border:none;

  padding:11px 18px;

  border-radius:9px;

  font-weight:bold;

  cursor:pointer;

}


/* ===============================
   PREMIUM MOCK TEST
================================ */

.mock-card{

  background:

  linear-gradient(
    135deg,
    #111827,
    #312e81
  );

}


.mock-card
.open-book{

  color:#312e81;

}


/* ===============================
   SKILL COURSE
================================ */

.skill-card{

  background:

  linear-gradient(
    135deg,
    #0f766e,
    #0891b2
  );

}


/* ===============================
   LOADING
================================ */

.loading{

  background:white;

  padding:30px;

  text-align:center;

  border-radius:15px;

  box-shadow:
  0 5px 15px #0001;

}


.no-access{

  background:white;

  padding:35px;

  border-radius:18px;

  text-align:center;

  box-shadow:
  0 5px 20px #0001;

}


.no-access h2{

  margin-top:0;

}


/* ===============================
   MODAL
================================ */

.modal{

  display:none;

  position:fixed;

  inset:0;

  background:#0009;

  z-index:9999;

  align-items:center;

  justify-content:center;

  padding:18px;

}


.modal-box{

  width:100%;

  max-width:650px;

  max-height:85vh;

  overflow:auto;

  background:white;

  border-radius:20px;

  padding:25px;

}


.modal-box h2{

  margin-top:0;

}


.modal-content{

  line-height:1.8;

  color:#374151;

}


.close-btn{

  width:100%;

  margin-top:20px;

  padding:14px;

  border:none;

  border-radius:10px;

  background:#2563eb;

  color:white;

  font-weight:bold;

  cursor:pointer;

}


/* ===============================
   MOBILE
================================ */

@media(max-width:600px){

  .header-container{

    align-items:flex-start;

  }


  .logo h2{

    font-size:20px;

  }


  .course-hero h1{

    font-size:23px;

  }


  .book-grid{

    grid-template-columns:
    repeat(2,1fr);

    gap:14px;

  }


  .book-card{

    height:270px;

  }


  .book-cover{

    padding:16px 13px;

  }


  .book-middle h3{

    font-size:18px;

  }


  .book-middle p{

    font-size:11px;

  }


  .book-icon{

    width:42px;

    height:42px;

    font-size:22px;

  }


  .book-tag{

    font-size:9px;

    padding:5px 7px;

  }


  .open-book{

    font-size:11px;

    padding:9px 10px;

  }

}

</style>

</head>


<body>


<!-- ===============================
     HEADER
================================ -->

<header>

<div class="header-container">

<div class="logo">

<h2>
📚 Padho Aur Kamao
</h2>

<p>
सीखें • Practice करें • आगे बढ़ें
</p>

</div>


<button
class="back-btn"
onclick="goDashboard()">

← Dashboard

</button>

</div>

</header>



<!-- ===============================
     MAIN
================================ -->

<main>


<div
id="loading"
class="loading">

📚 Course loading...

</div>


<div
id="courseContent"
style="display:none">


<!-- HERO -->

<div
class="course-hero">

<h1
id="packageTitle">

My Course

</h1>


<p
id="packageDescription">

</p>


<div
class="package-badge"
id="packageBadge">

ACTIVE PACKAGE

</div>

</div>



<!-- BOOK SECTION -->

<div
id="bookSections">

</div>


</div>



<!-- NO ACCESS -->

<div
id="noAccess"
class="no-access"
style="display:none">

<h2>
🔒 Course Access Required
</h2>

<p>
आपके पास इस course का access नहीं है।
कृपया पहले Dashboard से package purchase करें।
</p>


<button
class="back-btn"
onclick="goDashboard()">

← Go to Dashboard

</button>

</div>


</main>



<!-- ===============================
     BOOK MODAL
================================ -->

<div
id="bookModal"
class="modal">


<div
class="modal-box">


<h2
id="modalBookTitle">

Study Material

</h2>


<div
id="modalBookContent"
class="modal-content">

</div>


<button
class="close-btn"
onclick="closeBook()">

Close Book

</button>


</div>

</div>



<script type="module">


/* ===============================
   FIREBASE IMPORTS
================================ */

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


import {
getAuth,
onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";


import {
getFirestore,
doc,
getDoc
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";



/* ===============================
   FIREBASE CONFIG
================================ */

const firebaseConfig = {

apiKey:
"YOUR_API_KEY",

authDomain:
"YOUR_PROJECT.firebaseapp.com",

projectId:
"YOUR_PROJECT_ID",

storageBucket:
"YOUR_PROJECT.firebasestorage.app",

messagingSenderId:
"YOUR_SENDER_ID",

appId:
"YOUR_APP_ID"

};



/* ===============================
   INITIALIZE FIREBASE
================================ */

const app =
initializeApp(firebaseConfig);


const auth =
getAuth(app);


const db =
getFirestore(app);



/* ===============================
   GET COURSE ID
================================ */

const params =
new URLSearchParams(
window.location.search
);


const packageId =
params.get("id");



/* ===============================
   PACKAGE DATA
================================ */

const packageData = {


/* =================================
