<!DOCTYPE html>
<html lang="hi">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Courses Packages - Padho Aur Kamao</title>


<style>

/* =========================
   GLOBAL
========================= */

*{
box-sizing:border-box;
margin:0;
padding:0;
}

html{
scroll-behavior:smooth;
}

body{

font-family:
Arial,
Helvetica,
sans-serif;

background:
linear-gradient(
180deg,
#f7f7ff 0%,
#eef2ff 100%
);

color:#172033;

min-height:100vh;

}

a{
text-decoration:none;
color:inherit;
}

button{
font-family:inherit;
}


/* =========================
   HEADER
========================= */

header{

width:100%;

height:75px;

display:flex;

align-items:center;

justify-content:space-between;

padding:0 6%;

background:#ffffffd9;

backdrop-filter:blur(12px);

border-bottom:
1px solid #e8e8f0;

position:sticky;

top:0;

z-index:1000;

}


.logo{

display:flex;

align-items:center;

gap:10px;

font-size:20px;

font-weight:800;

color:#4f1fa8;

}


.logo-icon{

width:42px;

height:42px;

border-radius:12px;

display:flex;

align-items:center;

justify-content:center;

font-size:22px;

color:white;

background:
linear-gradient(
135deg,
#5b21b6,
#8b5cf6
);

box-shadow:
0 8px 20px
rgba(91,33,182,.25);

}


.nav-buttons{

display:flex;

align-items:center;

gap:10px;

}


.login-btn{

padding:
11px 20px;

border-radius:10px;

border:
1px solid #6526d7;

background:white;

color:#6526d7;

font-size:14px;

font-weight:bold;

cursor:pointer;

transition:.25s;

}


.login-btn:hover{

background:#f4efff;

}


.signup-btn{

padding:
11px 20px;

border:0;

border-radius:10px;

background:
linear-gradient(
135deg,
#6526d7,
#8b5cf6
);

color:white;

font-size:14px;

font-weight:bold;

cursor:pointer;

box-shadow:
0 7px 18px
rgba(101,38,215,.25);

transition:.25s;

}


.signup-btn:hover{

transform:
translateY(-2px);

}


/* =========================
   HERO
========================= */

.hero{

text-align:center;

padding:
55px 20px
35px;

}


.hero-small{

font-size:18px;

font-style:italic;

color:#4b5563;

margin-bottom:14px;

}


.hero h1{

font-size:42px;

line-height:1.25;

font-weight:800;

color:#172033;

}


.gradient-text{

background:
linear-gradient(
90deg,
#ec4899,
#f97316,
#7c3aed,
#2563eb
);

-webkit-background-clip:text;

background-clip:text;

color:transparent;

}


.hero p{

margin-top:16px;

color:#667085;

font-size:16px;

}


/* =========================
   COURSE CONTAINER
========================= */

.courses{

max-width:1100px;

margin:auto;

padding:
20px 20px
70px;

}


/* =========================
   COURSE CARD
========================= */

.course-card{

background:white;

border-radius:30px;

overflow:hidden;

margin-bottom:45px;

box-shadow:
0 20px 50px
rgba(37,40,80,.15);

border:
1px solid
rgba(255,255,255,.8);

transition:.3s;

}


.course-card:hover{

transform:
translateY(-6px);

box-shadow:
0 30px 65px
rgba(37,40,80,.22);

}


/* =========================
   COVER
========================= */

.course-cover{

height:430px;

position:relative;

overflow:hidden;

display:flex;

align-items:center;

justify-content:space-between;

padding:45px 70px;

}


/* STARTER */

.starter-cover{

background:
linear-gradient(
135deg,
#9c5d22,
#51301e 45%,
#201a25
);

}


/* PREMIUM */

.premium-cover{

background:
linear-gradient(
135deg,
#0d6d72,
#22a6a4 45%,
#1b4d9b
);

}


/* GRID */

.course-cover:before{

content:"";

position:absolute;

inset:0;

opacity:.15;

background-image:

linear-gradient(
rgba(255,255,255,.5) 1px,
transparent 1px
),

linear-gradient(
90deg,
rgba(255,255,255,.5) 1px,
transparent 1px
);

background-size:
25px 25px;

}


/* CIRCLE */

.course-cover:after{

content:"";

position:absolute;

width:420px;

height:420px;

border:

3px solid
rgba(255,255,255,.35);

border-radius:50%;

right:-160px;

bottom:-210px;

}


/* =========================
   COVER TEXT
========================= */

.cover-left{

position:relative;

z-index:5;

max-width:50%;

}


.cover-tag{

font-size:58px;

font-weight:bold;

color:
rgba(255,255,255,.7);

margin-bottom:15px;

}


.cover-title{

font-size:68px;

font-weight:800;

line-height:1;

color:white;

text-shadow:
0 8px 20px
rgba(0,0,0,.35);

}


.cover-subtitle{

font-size:18px;

color:#ffffffcc;

margin-top:18px;

line-height:1.6;

}


/* =========================
   BOOK
========================= */

.book-area{

position:relative;

z-index:10;

width:320px;

height:340px;

display:flex;

align-items:center;

justify-content:center;

}


.book{

width:220px;

height:290px;

position:relative;

transform:
perspective(1000px)
rotateY(-18deg)
rotateZ(2deg);

transform-style:
preserve-3d;

border-radius:
4px 8px 8px 4px;

box-shadow:

20px 25px 25px
rgba(0,0,0,.35),

inset 8px 0 10px
rgba(255,255,255,.08);

overflow:visible;

}


.book-starter{

background:
linear-gradient(
135deg,
#071a34,
#102b50
);

}


.book-premium{

background:
linear-gradient(
135deg,
#063b20,
#136436
);

}


/* BOOK SPINE */

.book:before{

content:"";

position:absolute;

left:-23px;

top:7px;

width:25px;

height:276px;

transform:
rotateY(65deg);

transform-origin:right;

background:
linear-gradient(
90deg,
#111827,
#334155
);

border-radius:
3px 0 0 3px;

}


/* PAGES */

.book:after{

content:"";

position:absolute;

right:-12px;

top:12px;

width:13px;

height:266px;

background:
repeating-linear-gradient(

0deg,

#e5e7eb 0px,
#ffffff 2px,
#d1d5db 3px

);

transform:
rotateY(55deg);

transform-origin:left;

border-radius:
0 3px 3px 0;

}


.book-content{

position:absolute;

inset:0;

padding:
28px 20px;

border:
1px solid
rgba(255,255,255,.15);

border-radius:
4px 8px 8px 4px;

color:white;

text-align:center;

}


.book-brand{

font-size:12px;

opacity:.7;

margin-bottom:30px;

}


.book-package{

font-size:12px;

letter-spacing:2px;

writing-mode:
vertical-rl;

position:absolute;

left:15px;

top:75px;

opacity:.75;

}


.book-name{

font-family:
Georgia,
serif;

font-size:29px;

font-weight:bold;

margin-top:55px;

line-height:1.2;

text-transform:uppercase;

}


.book-line{

height:2px;

background:
rgba(255,255,255,.4);

margin:
35px 20px
12px;

}


.book-bottom{

font-size:11px;

opacity:.75;

}


/* =========================
   CARD BODY
========================= */

.course-body{

padding:
32px 40px
35px;

}


.course-title-row{

display:flex;

align-items:center;

justify-content:space-between;

gap:20px;

padding-bottom:22px;

border-bottom:
1px dashed #d1d5db;

}


.course-name{

font-size:38px;

font-weight:700;

background:
linear-gradient(
90deg,
#6526d7,
#312e81
);

-webkit-background-clip:text;

background-clip:text;

color:transparent;

}


.course-count{

font-size:22px;

display:flex;

align-items:center;

gap:10px;

white-space:nowrap;

color:#1f2937;

}


.course-rating{

margin:
25px 0;

font-size:28px;

letter-spacing:5px;

color:#fbbf24;

}


/* =========================
   INFO
========================= */

.course-info{

display:flex;

justify-content:space-between;

align-items:center;

gap:25px;

flex-wrap:wrap;

}


.buy-btn{

border:0;

padding:
17px 40px;

border-radius:40px;

font-size:25px;

font-weight:500;

color:white;

cursor:pointer;

background:
linear-gradient(
135deg,
#ec00a7,
#8b5cf6
);

box-shadow:
0 12px 25px
rgba(139,92,246,.35);

transition:.25s;

}


.buy-btn:hover{

transform:
translateY(-3px)
scale(1.02);

}


.price-box{

display:flex;

align-items:center;

gap:18px;

}


.current-price{

font-size:38px;

font-weight:800;

color:#4f1fa8;

}


.old-price{

font-size:23px;

color:#6b7280;

text-decoration:
line-through;

}


/* =========================
   FEATURES
========================= */

.course-features{

margin-top:25px;

padding-top:22px;

border-top:
1px solid #eef0f4;

display:grid;

grid-template-columns:
repeat(3,1fr);

gap:12px;

}


.feature{

background:#f8f7ff;

border-radius:12px;

padding:13px;

font-size:13px;

color:#4b5563;

text-align:center;

}


/* =========================
   FOOTER
========================= */

footer{

text-align:center;

padding:
25px 15px;

background:white;

border-top:
1px solid #e5e7eb;

color:#6b7280;

font-size:14px;

}


/* =========================
   MOBILE
========================= */

@media(max-width:800px){

header{

padding:
0 15px;

height:65px;

}

.logo{

font-size:15px;

}

.logo-icon{

width:36px;

height:36px;

font-size:18px;

}

.login-btn,
.signup-btn{

padding:
9px 12px;

font-size:12px;

}

.hero{

padding:
40px 15px
25px;

}

.hero-small{

font-size:16px;

}

.hero h1{

font-size:31px;

}

.hero p{

font-size:14px;

}

.courses{

padding:
10px 15px
50px;

}

.course-card{

border-radius:25px;

margin-bottom:30px;

}

.course-cover{

height:430px;

padding:
35px 25px;

flex-direction:column;

justify-content:center;

}

.cover-left{

max-width:100%;

text-align:center;

}

.cover-tag{

font-size:32px;

margin-bottom:5px;

}

.cover-title{

font-size:48px;

}

.cover-subtitle{

font-size:14px;

margin-top:10px;

}

.book-area{

width:220px;

height:260px;

margin-top:5px;

}

.book{

width:170px;

height:225px;

}

.book:before{

height:215px;

}

.book:after{

height:205px;

}

.book-content{

padding:18px 12px;

}

.book-brand{

margin-bottom:12px;

font-size:10px;

}

.book-package{

font-size:9px;

left:10px;

top:55px;

}

.book-name{

font-size:21px;

margin-top:35px;

}

.book-line{

margin:
22px 15px
8px;

}

.course-body{

padding:
25px 20px;

}

.course-title-row{

align-items:flex-start;

flex-direction:column;

gap:12px;

}

.course-name{

font-size:34px;

}

.course-count{

font-size:19px;

}

.course-rating{

font-size:23px;

}

.course-info{

flex-direction:column-reverse;

align-items:stretch;

}

.buy-btn{

width:100%;

font-size:22px;

}

.price-box{

justify-content:center;

}

.course-features{

grid-template-columns:1fr;

}

}


@media(max-width:390px){

.nav-buttons{

gap:6px;

}

.login-btn,
.signup-btn{

padding:
8px 9px;

font-size:11px;

}

.logo{

font-size:13px;

gap:5px;

}

.cover-title{

font-size:40px;

}

.course-name{

font-size:29px;

}

.current-price{

font-size:32px;

}

}

</style>

</head>


<body>


<!-- =========================
     HEADER
========================= -->

<header>


<a href="course.html"
class="logo">

<div class="logo-icon">

📚

</div>

<span>
Padho Aur Kamao
</span>

</a>


<div class="nav-buttons">

<a
href="login.html"
class="login-btn">

Login

</a>


<a
href="login.html#signup"
class="signup-btn">

Sign Up

</a>

</div>


</header>



<!-- =========================
     HERO
========================= -->

<section class="hero">


<div class="hero-small">

Courses Packages

</div>


<h1>

Choose The Perfect

<br>

<span class="gradient-text">

Course Package

</span>

For You

</h1>


<p>

अपनी Skills बढ़ाएं • सीखें • आगे बढ़ें

</p>


</section>



<!-- =========================
     COURSES
========================= -->

<main class="courses">



<!-- =========================
     COURSE 1
========================= -->

<section class="course-card">


<div
class="
course-cover
starter-cover
">


<div class="cover-left">


<div class="cover-tag">

&lt;/&gt;

</div>


<div class="cover-title">

Study

<br>

& Skill

</div>


<div class="cover-subtitle">

Learning • Communication

<br>

Maths • Reasoning • Hindi

</div>


</div>



<div class="book-area">


<div
class="
book
book-starter
">


<div class="book-content">


<div class="book-brand">

Padho Aur Kamao

</div>


<div class="book-package">

STARTER PACKAGE

</div>


<div class="book-name">

STUDY

<br>

& SKILL

<br>

STARTER

</div>


<div class="book-line">

</div>


<div class="book-bottom">

Learn • Practice • Grow

</div>


</div>


</div>


</div>


</div>



<div class="course-body">


<div class="course-title-row">


<h2 class="course-name">

Study & Skill Starter

</h2>


<div class="course-count">

📚

2 Courses

</div>


</div>


<div class="course-rating">

★ ★ ★ ★ ☆

</div>


<div class="course-info">


<button
class="buy-btn"
data-course="study-skill-starter"
onclick="joinCourse(this.dataset.course)">

❯ Buy Now

</button>


<div class="price-box">


<span class="current-price">

₹199

</span>


<span class="old-price">

₹299

</span>


</div>


</div>


<div class="course-features">


<div class="feature">

📖 Study Material

</div>


<div class="feature">

🎯 Skill Learning

</div>


<div class="feature">

📚 2 Courses Access

</div>


</div>


</div>


</section>





<!-- =========================
     COURSE 2
========================= -->

<section class="course-card">


<div
class="
course-cover
premium-cover
">


<div class="cover-left">


<div class="cover-tag">

▶

</div>


<div class="cover-title">

Skill

<br>

& Success

</div>


<div class="cover-subtitle">

Competitive Preparation

<br>

Skills • Growth • Success

</div>


</div>



<div class="book-area">


<div
class="
book
book-premium
">


<div class="book-content">


<div class="book-brand">

Padho Aur Kamao

</div>


<div class="book-package">

PREMIUM PACKAGE

</div>


<div class="book-name">

SKILL

<br>

& SUCCESS

<br>

PREMIUM

</div>


<div class="book-line">

</div>


<div class="book-bottom">

Learn • Grow • Succeed

</div>


</div>


</div>


</div>


</div>



<div class="course-body">


<div class="course-title-row">


<h2 class="course-name">

Skill & Success Premium

</h2>


<div class="course-count">

📚

All Courses

</div>


</div>


<div class="course-rating">

★ ★ ★ ★ ★

</div>


<div class="course-info">


<button
class="buy-btn"
data-course="skill-success-premium"
onclick="joinCourse(this.dataset.course)">

❯ Buy Now

</button>


<div class="price-box">


<span class="current-price">

₹399

</span>


<span class="old-price">

₹499

</span>


</div>


</div>


<div class="course-features">


<div class="feature">

🎓 Competitive Preparation

</div>


<div class="feature">

🚀 Premium Skills

</div>


<div class="feature">

♾️ Full Course Access

</div>


</div>


</div>


</section>


</main>



<!-- =========================
     FOOTER
========================= -->

<footer>

© 2026 Padho Aur Kamao • Learn • Earn • Grow

</footer>



<!-- =========================
     FIREBASE
========================= -->

<script type="module">


import {

initializeApp

}

from

"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


import {

getAuth,
onAuthStateChanged

}

from

"https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";



/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig={


apiKey:

"AIzaSyDhYPTmWOqYgUOk3a0QK0WJBFIYlGZdWA0",


authDomain:

"padho-aur-kamao-3eeae.firebaseapp.com",


projectId:

"padho-aur-kamao-3eeae",


storageBucket:

"padho-aur-kamao-3eeae.firebasestorage.app",


messagingSenderId:

"670063905617",


appId:

"1:670063905617:web:9b3a7e62fdeea14fbfa170"


};



const app=

initializeApp(
firebaseConfig
);


const auth=

getAuth(
app
);



/* =========================
   CURRENT USER
========================= */

let loggedInUser=null;


onAuthStateChanged(

auth,

user=>{


if(user){

loggedInUser=user;

}

}

);



/* =========================
   JOIN COURSE
========================= */

window.joinCourse=

function(courseId){


/* अगर Login नहीं है */

if(!loggedInUser){


window.location.href=

"login.html?course="+

encodeURIComponent(
courseId
);


return;

}



/* Login है */

window.location.href=

"dashboard.html?course="+

encodeURIComponent(
courseId
);


};


</script>


</body>

</html>
