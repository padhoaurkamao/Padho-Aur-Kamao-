/* ===============================
   AUTH CHECK
================================ */

onAuthStateChanged(
auth,
async user => {


if(!user){

window.location.href =
"login.html";

return;

}


if(!packageId){

showNoAccess();

return;

}


const enrollmentId =

user.uid +
"_" +
packageId;


try{


const enrollmentSnap =

await getDoc(

doc(
db,
"enrollments",
enrollmentId
)

);


if(

!enrollmentSnap.exists()

||

enrollmentSnap
.data()
.status !== "active"

){

showNoAccess();

return;

}


const packageInfo =

packageData[
packageId
];


if(!packageInfo){

showNoAccess();

return;

}


loadCourse(
packageInfo
);


}catch(error){

console.error(error);

showNoAccess();

}

}
);



/* ===============================
   LOAD COURSE
================================ */

function loadCourse(
packageInfo
){


document
.getElementById("loading")
.style.display =
"none";


document
.getElementById("courseContent")
.style.display =
"block";


document
.getElementById("packageTitle")
.textContent =
packageInfo.title;


document
.getElementById("packageDescription")
.textContent =
packageInfo.description;


const container =

document
.getElementById(
"bookSections"
);


container.innerHTML =
"";


packageInfo
.sections
.forEach(
section => {


const sectionElement =

document.createElement(
"section"
);


sectionElement.innerHTML =

`

<div class="section-title">

<h2>

${safe(
section.title
)}

</h2>

<p>

अपनी पसंद की Digital Book खोलें और Study शुरू करें।

</p>

</div>


<div class="book-grid">

${

section.books
.map(
book =>
createBook(
book
)
)
.join("")

}

</div>

`;


container.appendChild(
sectionElement
);

}
);

}



/* ===============================
   CREATE BOOK
================================ */

function createBook(
book
){


const bookData =
encodeURIComponent(
JSON.stringify(
book
)
);


return `

<div
class="book-card"
data-book="${bookData}">


<div
class="
book-cover
${safe(book.color)}
${book.mock ? " mock-card" : ""}
">


<div
class="book-top">


<div
class="book-icon">

${safe(
book.icon
)}

</div>


<div
class="book-tag">

${safe(
book.tag
)}

</div>


</div>



<div
class="book-middle">


<h3>

${safe(
book.title
)}

</h3>


<p>

Padho Aur Kamao

<br>

Digital Study Book

</p>


</div>



<div
class="book-bottom">


<button
class="open-book">

📖 Open Book

</button>


</div>


</div>


</div>

`;

}



/* ===============================
   BOOK CLICK
================================ */

document.addEventListener(
"click",
event => {


const bookCard =

event.target.closest(
".book-card"
);


if(!bookCard)
return;


const encodedBook =

bookCard.dataset.book;


const book =

JSON.parse(

decodeURIComponent(
encodedBook
)

);


openBook(
book
);

}
);



/* ===============================
   OPEN BOOK
================================ */

window.openBook =
function(book){


document
.getElementById(
"modalBookTitle"
)
.textContent =
book.icon +
" " +
book.title;


document
.getElementById(
"modalBookContent"
)
.innerHTML =
book.content;


document
.getElementById(
"bookModal"
)
.style.display =
"flex";

};



/* ===============================
   CLOSE BOOK
================================ */

window.closeBook =
function(){


document
.getElementById(
"bookModal"
)
.style.display =
"none";

};



/* ===============================
   DASHBOARD
================================ */

window.goDashboard =
function(){

window.location.href =
"dashboard.html";

};



/* ===============================
   NO ACCESS
================================ */

function showNoAccess(){


document
.getElementById(
"loading"
)
.style.display =
"none";


document
.getElementById(
"noAccess"
)
.style.display =
"block";

}



/* ===============================
   SAFE HTML
================================ */

function safe(value){

return String(value)

.replaceAll(
"&",
"&amp;"
)

.replaceAll(
"<",
"&lt;"
)

.replaceAll(
">",
"&gt;"
)

.replaceAll(
'"',
"&quot;"
)

.replaceAll(
"'",
"&#039;"
);

}


</script>

</body>
</html>
